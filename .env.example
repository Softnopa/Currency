# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# "Publishable key" (sb_publishable_...) — or the legacy "anon public" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) — or the legacy "service_role" key. Server only, never share.
SUPABASE_SECRET_KEY=
# Any long random string. Vercel sends it to the daily rate-refresh cron job.
CRON_SECRET=
